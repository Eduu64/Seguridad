# ── Variables del stack de seguridad ──────────────────────────────────────────
# setup.sh rellena automáticamente CROWDSEC_BOUNCER_KEY y GID la primera vez.

# Clave API que comparten crowdsec y el bouncer (la genera setup.sh con openssl).
# NO la cambies después del primer arranque sin regenerar: el bouncer quedaría
# sin autorización (arregla con: docker compose exec crowdsec cscli bouncers add mi-clave).
CROWDSEC_BOUNCER_KEY=

# Zona horaria para los logs
TZ=Europe/Madrid

# GID del grupo docker en el host (setup.sh lo detecta con: stat -c %g /var/run/docker.sock)
GID=999

# ── Panel web local (dashboard de CrowdSec) ───────────────────────────────────
# Puerto del panel en el host: elige uno LIBRE (aquí 8080/8090/3000 ya están ocupados).
PANEL_PORT=8096

# Contraseña watcher del panel contra la LAPI (la genera setup.sh; no la edites
# después del primer arranque sin recrear: docker compose up -d --force-recreate panel-setup)
PANEL_WATCHER_PASSWORD=

# Contraseña de ESCRITURAS del panel (déjala VACÍA = sin login y sin login para
# nadie: el panel abre directo y es de SOLO LECTURA). Defínela solo si quieres
# poder banear/desbanear/borrar desde el panel: entonces pide login y las acciones
# van auditadas. Recrea después: docker compose up -d --force-recreate panel
PANEL_UI_PASSWORD=

# (Opcional) webhook de DISCORD para las notificaciones (https://discord.com/
# api/webhooks/...). También acepta ntfy/Gotify en tu LAN. Vacío = nada sale de
# tu red. SOLO sale el texto del aviso (baneo nuevo, pico de alertas, prueba)
# hacia esa URL — ningún log ni dato más.
DISCORD_WEBHOOK_URL=
